document.addEventListener('DOMContentLoaded', () => {
  obtenerYRenderizarRutas();
});

async function obtenerYRenderizarRutas() {
  const contenedor = document.getElementById('contenedor-rutas');
  if (!contenedor) return;

  contenedor.innerHTML = `
    <div style="grid-column: 1/-1; text-align: center; padding: 2rem; color: #163A24;">
      <i class="fa-solid fa-spinner fa-spin fa-2x"></i>
      <p style="margin-top: 0.5rem; font-size: 0.95rem;">Cargando rutas turísticas...</p>
    </div>
  `;

  try {
    const respuesta = await fetch(API_URL);
    if (!respuesta.ok) throw new Error(`HTTP: ${respuesta.status}`);
    const rutas = await respuesta.json();
    renderizarTarjetas(rutas, contenedor);
  } catch (error) {
    console.warn("API inaccesible, cargando rutas de respaldo:", error);
    renderizarTarjetas(RUTAS_FALLBACK, contenedor);
  }
}

function renderizarTarjetas(listaRutas, contenedor) {
  contenedor.innerHTML = '';
  if (!listaRutas || listaRutas.length === 0) {
    contenedor.innerHTML = `<p style="grid-column: 1/-1; text-align: center;">No hay rutas disponibles.</p>`;
    return;
  }

  listaRutas.forEach(ruta => {
    const tarjeta = document.createElement('article');
    tarjeta.className = 'tarjeta-actividad';
    tarjeta.innerHTML = `
      <img src="${ruta.imagen || 'https://via.placeholder.com/600x400'}" alt="${ruta.nombre}">
      <div class="tarjeta-cuerpo">
        <h3>${ruta.nombre}</h3>
        <span class="categoria">${ruta.categoria} • ${ruta.ubicacion}</span>
        <p class="duracion"><i class="fa-regular fa-clock"></i> Duración: ${ruta.duracion} · Dificultad: ${ruta.dificultad}</p>
        <div class="acciones-tarjeta">
          <a href="#" class="btn-ver-ficha" data-id="${ruta.id}">Ver ficha</a>
        </div>
      </div>
    `;
    contenedor.appendChild(tarjeta);
  });

  vincularBotonesFicha();
}

function vincularBotonesFicha() {
  const botonesFicha = document.querySelectorAll('.btn-ver-ficha');
  botonesFicha.forEach(boton => {
    boton.addEventListener('click', (e) => {
      e.preventDefault();
      const idActividad = boton.getAttribute('data-id');
      if (idActividad) {
        window.location.href = `paginas/Actividad.html?id=${idActividad}`;
      }
    });
  });
}